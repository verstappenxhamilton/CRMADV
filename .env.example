# Ambiente e Execução
NODE_ENV=development
PORT=3000

# Provedores Simulados (MOCK_PROVIDERS=true somente para desenvolvimento/testes locais)
# AVISO: O sistema recusa inicialização se MOCK_PROVIDERS=true em produção.
MOCK_PROVIDERS=true

# Supabase (Banco, Auth e Storage Privado)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# Scanner de Arquivos (HTTPS)
CLOUDMERSIVE_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (E-mail transacional)
RESEND_API_KEY=
EMAIL_FROM=atendimento@exemplo.com.br
